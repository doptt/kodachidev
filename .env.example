# Copy this file to .env.local and fill it in for local development.
# In production, set the same variables in Vercel → Project → Settings →
# Environment Variables. Never commit real keys.

# Resend API key (resend.com/api-keys). "Sending access" is all it needs.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. The domain must be verified in Resend.
CONTACT_FROM_EMAIL="kodachi.dev <noreply@kodachi.dev>"

# Where contact form messages are delivered.
CONTACT_TO_EMAIL=contact@kodachi.dev

# Optional: extra origins allowed to post to /api/contact (comma-separated).
# The site's own domain always works, so this is usually left empty.
ALLOWED_ORIGINS=
